@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
title AgentHive - System Context

Person(admin, "Team Admin", "Reviews pending memory, resolves disputed notes, manages users and rules")
Person(member, "Team Member", "Runs a coding-agent session against the team's memory")

System(agenthive, "AgentHive", "Shared, reviewed memory graph for a team of coding agents. Team-scoped, bounded retrieval by traversal, disclosed in layers, and able to say whether any of it is helping")

System_Ext(coding_agent, "Coding Agent Session", "Claude Code, VS Code or Cursor. Retrieves team context, reports back on notes it used, and logs what it learned")
System_Ext(plugin, "AgentHive Plugin", "Harness hooks running outside the agent's loop: injects known facts at session start, pools tool-usage evidence, and backstops a session that ended without logging")
System_Ext(otel_backend, "OTLP Backend", "Jaeger, Tempo, or any OTLP/HTTP-compatible tracing backend")
System_Ext(prometheus, "Prometheus", "Scrapes token, disclosure, review-queue and evidence metrics")

Rel(member, coding_agent, "Runs")
Rel(coding_agent, agenthive, "Retrieve, fetch, report gaps, confirm or contradict, log", "HTTPS/JSON")
Rel(plugin, agenthive, "Fetches facts, reports tool usage, records unsummarised sessions", "HTTPS/JSON")
Rel(admin, agenthive, "Reviews the queue and the disputed list, accepts or ignores proposals", "HTTPS")
Rel(agenthive, otel_backend, "Exports one trace per request when tracing is enabled", "OTLP/HTTP")
Rel(prometheus, agenthive, "Scrapes", "HTTP GET /metrics")

@enduml
