@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title AgentHive - Container Diagram

Person(admin, "Team Admin", "Reviews the queue and the disputed list, accepts or ignores proposals")
Person(member, "Team Member", "Runs a coding-agent session")

System_Ext(coding_agent, "Coding Agent Session", "Retrieval at session start, feedback on notes used, log at the end")
System_Ext(plugin, "AgentHive Plugin", "Harness hooks, outside the agent's loop - facts, tool-usage evidence, session-end backstop")
System_Ext(otel_backend, "OTLP Backend", "Jaeger, Tempo or any OTLP/HTTP backend")
System_Ext(prometheus, "Prometheus", "Scrapes on an interval")

System_Boundary(agenthive, "AgentHive") {
  Container(api, "AgentHive Service", "Python 3.11, stdlib http.server", "Auth and rate limiting; the approval gate, which strips author-marked private blocks before storage and holds reserved-tag writes for human review; retrieval by bounded traversal, resolved by exact title then human-recorded alias then token fallback, and served full or as an index depending on size; environment facts injected without an anchor; a measurement holdout that withholds memory from a deterministic share of sessions and says so; the review UI; metrics; OpenTelemetry spans")
  ContainerDb(db, "Memory Store", "SQLite file or PostgreSQL", "Teams, users, agents and tasks; tiered memory nodes (pending / approved / rejected) with the verdicts later sessions passed on them; anchor aliases; the per-retrieval access log; the aggregated miss log; pooled tool-usage evidence; and one row per agent session, which is what makes 'did memory help' answerable at all")
  ContainerDb(cache, "Rate Limiter + Retrieval Cache", "In-memory (single replica) or Redis (shared)", "Per-token rate-limit counters; one cached traversal per anchor serving both disclosure modes, invalidated on anything that changes what retrieval would return - including a rejection, which used to be missed")
}

Rel(member, coding_agent, "Runs")
Rel(coding_agent, api, "Retrieve, fetch, gaps, feedback, log", "HTTPS/JSON, X-API-Key")
Rel(plugin, api, "Facts, tool usage, unsummarised sessions", "HTTPS/JSON, X-API-Key")
Rel(admin, api, "Reviews, resolves disputes, configures rules and aliases", "HTTPS")
Rel(api, db, "Reads/writes", "SQL")
Rel(api, cache, "Rate-limit checks, cache lookups and writes", "in-process, or Redis protocol")
Rel(api, otel_backend, "Exports spans when tracing is enabled", "OTLP/HTTP")
Rel(prometheus, api, "Scrapes", "HTTP GET /metrics")

@enduml
