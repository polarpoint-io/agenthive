# Copy to .env and adjust. server.py doesn't load .env files itself (no
# dependency on python-dotenv) - use `docker compose`, systemd's
# EnvironmentFile=, or `export $(cat .env | xargs)` to apply it.

AGENTHIVE_HOST=0.0.0.0
AGENTHIVE_PORT=8790

# Leave DATABASE_URL empty to use SQLite at AGENTHIVE_DB_PATH.
# Required (with more than one replica) once you need concurrent writers.
DATABASE_URL=
AGENTHIVE_DB_PATH=/data/agenthive.db
# DATABASE_URL=postgresql://agenthive:agenthive@localhost:5432/agenthive

# Shares the rate limiter and retrieval cache across replicas. Leave
# empty for a single instance (both fall back to in-memory).
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

AGENTHIVE_RATE_LIMIT_ENABLED=true
AGENTHIVE_RATE_LIMIT_PER_MINUTE=120
AGENTHIVE_RATE_LIMIT_WINDOW_SECONDS=60

# 0 (default) - tokens minted/rotated never expire on their own. Set to
# expire them automatically after this many seconds; only applies going
# forward. See DEPLOYMENT.md / ADR.md's "Authentication" section.
AGENTHIVE_TOKEN_TTL_SECONDS=0

AGENTHIVE_CACHE_ENABLED=true
AGENTHIVE_CACHE_TTL_SECONDS=300

# Native TLS - leave both empty to serve plain HTTP (the usual choice
# when a reverse proxy or Ingress terminates TLS in front).
AGENTHIVE_TLS_CERT_FILE=
AGENTHIVE_TLS_KEY_FILE=

AGENTHIVE_METRICS_ENABLED=true

# Distributed tracing (OpenTelemetry) - off unless one of these is set.
# OTEL_EXPORTER_OTLP_ENDPOINT sends spans to Jaeger/Tempo/any OTLP-HTTP
# backend (docker-compose's `jaeger` profile runs one at this address).
# AGENTHIVE_TRACING_CONSOLE prints each finished span as JSON to stdout -
# no infrastructure needed, good for a first look. See ONBOARDING.md.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
AGENTHIVE_TRACING_CONSOLE=false

# Head-based sampling ratio, 0.0-1.0. 1.0 (default) traces every request -
# turn down for a high-throughput deployment. See ADR.md's "Reliability
# and observability" section.
AGENTHIVE_TRACE_SAMPLE_RATIO=1.0

# Azure AD (Microsoft Entra ID) sign-in for the review UI, humans only -
# off unless all four are set (agents keep using their personal tokens
# above unchanged). See ADR.md's "Authentication" section.
AGENTHIVE_AZURE_TENANT_ID=
AGENTHIVE_AZURE_CLIENT_ID=
AGENTHIVE_AZURE_CLIENT_SECRET=
AGENTHIVE_AZURE_REDIRECT_URI=
# AGENTHIVE_AZURE_REDIRECT_URI=https://agenthive.yourcompany.com/auth/azure/callback
# How long a session minted by a successful Azure sign-in lasts.
AGENTHIVE_AZURE_SESSION_TTL_SECONDS=3600

AGENTHIVE_LOG_LEVEL=INFO
AGENTHIVE_LOG_JSON=true
